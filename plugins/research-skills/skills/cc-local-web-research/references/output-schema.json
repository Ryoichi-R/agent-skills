{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "cc-local-web-research スキル出力スキーマ",
    "description": "スキル出力の構造化 JSON フォーマット。Markdown 末尾に <!-- JSON: {...} --> コメントとして併記する。",
    "type": "object",
    "required": ["sections", "sources", "metadata"],
    "properties": {
        "sections": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "prefixItems": [
                {
                    "type": "object",
                    "required": ["id", "title"],
                    "properties": {
                        "id": { "const": "local_info" },
                        "title": { "type": "string" }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": ["id", "title"],
                    "properties": {
                        "id": { "const": "web_info" },
                        "title": { "type": "string" }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": ["id", "title"],
                    "properties": {
                        "id": { "const": "deep_local_info" },
                        "title": { "type": "string" }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": ["id", "title"],
                    "properties": {
                        "id": { "const": "conclusion" },
                        "title": { "type": "string" }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": ["id", "title"],
                    "properties": {
                        "id": { "const": "sources" },
                        "title": { "type": "string" }
                    },
                    "additionalProperties": false
                }
            ],
            "items": false
        },
        "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["title", "source_type"],
                "properties": {
                    "url": {
                        "type": ["string", "null"],
                        "format": "uri",
                        "pattern": "^https://",
                        "description": "Web出典の完全URL"
                    },
                    "path": {
                        "type": ["string", "null"],
                        "description": "実行時に解決した資料ルート配下にあるローカル出典の絶対パス"
                    },
                    "title": {
                        "type": "string"
                    },
                    "source_type": {
                        "type": "string",
                        "enum": ["web", "local"]
                    },
                    "lines": {
                        "type": "object",
                        "properties": {
                            "start": { "type": "integer", "minimum": 1 },
                            "end": { "type": "integer", "minimum": 1 }
                        },
                        "required": ["start", "end"],
                        "additionalProperties": false,
                        "description": "ローカル出典の引用行範囲（source_type=local では必須）"
                    }
                },
                "additionalProperties": false,
                "allOf": [
                    {
                        "if": {
                            "required": ["source_type"],
                            "properties": { "source_type": { "const": "web" } }
                        },
                        "then": { "required": ["url"] }
                    },
                    {
                        "if": {
                            "required": ["source_type"],
                            "properties": {
                                "source_type": { "const": "local" }
                            }
                        },
                        "then": { "required": ["path", "lines"] }
                    }
                ]
            }
        },
        "conflict_resolution": {
            "type": "object",
            "required": ["detected"],
            "properties": {
                "detected": {
                    "type": "boolean"
                },
                "applied_rule": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "if": {
                "properties": { "detected": { "const": true } }
            },
            "then": {
                "required": ["detected", "applied_rule", "reason"]
            }
        },
        "metadata": {
            "type": "object",
            "required": ["step_number", "step_number_legacy", "schema_version"],
            "oneOf": [
                {
                    "properties": {
                        "schema_version": { "const": "1.0" },
                        "step_number": { "type": "integer", "const": 4 },
                        "step_number_legacy": { "type": "string" }
                    },
                    "required": [
                        "step_number",
                        "step_number_legacy",
                        "schema_version"
                    ],
                    "additionalProperties": false
                },
                {
                    "properties": {
                        "schema_version": { "const": "1.1" },
                        "step_number": { "type": "integer", "const": 4 },
                        "step_number_legacy": { "type": "string" },
                        "model": {
                            "type": "string",
                            "enum": [
                                "claude-opus-4-6",
                                "claude-sonnet-4-6",
                                "claude-haiku-4-5-20251001"
                            ]
                        }
                    },
                    "required": [
                        "step_number",
                        "step_number_legacy",
                        "schema_version",
                        "model"
                    ],
                    "additionalProperties": false
                }
            ]
        }
    },
    "additionalProperties": false
}
